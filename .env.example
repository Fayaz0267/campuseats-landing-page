# Where the EXISTING CampusEats frontend lives (no trailing slash).
VITE_APP_URL=http://localhost:3000

# Where the EXISTING CampusEats backend API lives.
VITE_API_URL=http://localhost:5000/api

# Paths inside the existing frontend that the landing page links to.
# "Login" uses VITE_LOGIN_PATH. "Start Ordering" / "Get Started" use VITE_START_PATH.
VITE_LOGIN_PATH=/login
VITE_START_PATH=/login

# true  = AI demo uses the built-in demo menu (no backend needed)
# false = AI demo calls POST {VITE_API_URL}/ai/food-search
VITE_USE_MOCK_AI=true
